# ── App ──────────────────────────────────────────────
APP_ENV=development

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/chatbot

# ── Qdrant ──────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=company_knowledge_base

# ── Groq (REQUIRED) ──────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# ── LLM Provider ──────────────────────────────────────
# Switch: "groq" (default, cloud) or "ollama" (local)
LLM_PROVIDER=groq
OLLAMA_CHAT_MODEL=qwen2.5:7b

# ── Ollama / Embedding ───────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3

# ── RAG Pipeline ────────────────────────────────────
SIMILARITY_THRESHOLD=0.40
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_QUERY_LENGTH=2000

# ── Session ──────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
SESSION_CLEANUP_INTERVAL=300

# ── Upload ───────────────────────────────────────────
MAX_FILE_SIZE_MB=50
DATA_DIR=/data

# ── Web Search (Hybrid RAG) ─────────────────────────
ENABLE_WEB_SEARCH=true
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=10
SEARCH_CACHE_TTL=3600

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limit ───────────────────────────────────────
RATE_LIMIT_WINDOW=60
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_ADMIN_MAX=15

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth (initial admin seeded on startup) ───────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
